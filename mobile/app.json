{
  "expo": {
    "name": "AMANE DZ",
    "slug": "amane-dz",
    "scheme": "amanedz",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "dz.amane.app",
      "buildNumber": "1",
      "supportsTablet": true
    },
    "android": {
      "package": "dz.amane.app",
      "permissions": [
        "CAMERA"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow AMANE DZ to scan QR codes.",
          "microphonePermission": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow AMANE DZ to scan QR codes from images."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#070b14",
          "image": "./assets/splash-icon.png",
          "imageWidth": 250
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
